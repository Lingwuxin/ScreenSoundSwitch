<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScreenSoundSwitch.WinUI.Views.ProcessControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenSoundSwitch.WinUI.Views"
    xmlns:control="using:ScreenSoundSwitch.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:local1="using:ScreenSoundSwitch.WinUI.ViewModels"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <local1:ProcessControlViewModel />
    </UserControl.DataContext>
    <Border
        x:Name="ProcessRowBorder"
        CornerRadius="6"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        Background="Transparent"
        Margin="0,0,0,2"
        Padding="2">
        <control:ContentControl>
            <control:ContentControl.Icon>
                <Image Source="{Binding ProcessModel.Icon}" Width="18" Height="18" />
            </control:ContentControl.Icon>
            <control:ContentControl.LeftContent>
                <TextBlock Text="{Binding ProcessModel.ProcessName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            </control:ContentControl.LeftContent>
            <control:ContentControl.RightContent>
                <Slider
                    x:Name="SimpleVolumeSlider"
                    ValueChanged="SimpleVolumeSlider_ValueChanged"
                    MinWidth="190"
                    MaxWidth="220"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Right"
                    Grid.Column="1"
                    Height="30"/>
            </control:ContentControl.RightContent>
        </control:ContentControl>
    </Border>

        <!-- 让Slider在第二列中右对齐 -->
</UserControl>
