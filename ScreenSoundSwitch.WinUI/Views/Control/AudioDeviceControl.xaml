<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScreenSoundSwitch.WinUI.Views.AudioDeviceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenSoundSwitch.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:control="using:ScreenSoundSwitch.WinUI.Controls"
    xmlns:viewModel="using:ScreenSoundSwitch.WinUI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModel:AudioDeviceControlViewModel/>
    </UserControl.DataContext>

    <Border
        Margin="0,0,0,8"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Padding="10,10,10,6">
        <StackPanel Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding AudioDeviceControlModel.DeviceName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Uid="MasterVolumeTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;"/>
                    <Slider
                        x:Name="MainVolumeSlider"
                        ValueChanged="MainVolumeSlider_ValueChanged"
                        Orientation="Horizontal"
                        Minimum="0"
                        Maximum="100"
                        Width="280"
                        Value="50"
                        Height="30"
                        Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Vertical" Spacing="4">
                <control:ContentControl>
                    <control:ContentControl.LeftContent>
                        <TextBlock x:Uid="LeftChannelTextBlock"/>
                    </control:ContentControl.LeftContent>
                    <control:ContentControl.RightContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LeftChannelVolumeText" Text="100" MinWidth="28"/>
                            <Slider
                                x:Name="LeftChannelSlider"
                                ValueChanged="LeftChannelSlider_ValueChanged"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Width="180"
                                Height="30"
                                Margin="10,0,0,0"/>
                        </StackPanel>
                    </control:ContentControl.RightContent>
                </control:ContentControl>
                <control:ContentControl>
                    <control:ContentControl.LeftContent>
                        <TextBlock x:Uid="RightChannelTextBlock"/>
                    </control:ContentControl.LeftContent>
                    <control:ContentControl.RightContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RightChannelVolumeText" Text="100" MinWidth="28"/>
                            <Slider
                                x:Name="RightChannelSlider"
                                ValueChanged="RightChannelSlider_ValueChanged"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Width="180"
                                Height="30"
                                Margin="10,0,0,0"/>
                        </StackPanel>
                    </control:ContentControl.RightContent>
                </control:ContentControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="SessionList_Expanded">
                <Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="SessionTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{Binding AudioDeviceControlModel.DeviceName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel x:Name="ProcessStackPanel" Spacing="2"/>
                </Expander.Content>
            </Expander>
        </StackPanel>
    </Border>
       
</UserControl>
